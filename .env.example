# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Connection string for your PostgreSQL database.
# The default below matches the local database started by `docker compose up -d`.
# For production, use your Neon (or other hosted Postgres) connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/pantry_db?schema=public"

# -----------------------------------------------------------------------------
# AI Configuration
# -----------------------------------------------------------------------------
# Google Gemini API key (free at https://aistudio.google.com/apikey).
# Without it, AI features degrade gracefully: auto-categorize falls back to OTHER,
# while voice input and recipe generation return an error message.
GEMINI_API_KEY="your_google_gemini_api_key"

# -----------------------------------------------------------------------------
# AWS Cognito Configuration
# -----------------------------------------------------------------------------
# These are prefixed with NEXT_PUBLIC_ so they can be exposed to the client-side
# AWS Amplify SDK for authentication. This is safe because Cognito Client IDs are public.
# Demo mode ("Try Demo") does not need a real user pool, but keep these placeholder
# values: the GraphQL route validates the pool ID format at startup.
NEXT_PUBLIC_AWS_REGION="us-east-1"
NEXT_PUBLIC_AWS_USER_POOL_ID="us-east-1_xxxxxxxxx"
NEXT_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Cron Job Configuration
# -----------------------------------------------------------------------------
# Secret key used to verify that incoming cron requests are legitimate.
# This MUST match the Authorization header sent by your cron provider (e.g., cron-job.org).
# Only enforced when NODE_ENV=production.
CRON_SECRET="replace-with-a-long-random-string"
